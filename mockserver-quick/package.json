{
  "name": "mockserver-quick",
  "version": "1.0.0",
  "description": "Generate a local mock REST API from a JSON data file.",
  "type": "module",
  "bin": {
    "mock-api": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs --file=examples/schema.json --port=4000",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mock-api", "rest-api", "development", "testing", "json"],
  "license": "MIT"
}
